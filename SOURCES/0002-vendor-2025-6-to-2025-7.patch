diff '--color=auto' -ruN rpm-ostree-2025.6/vendor/zerocopy/tests/ui-msrv/ptr-is-invariant-over-v.rs rpm-ostree-2025.7/vendor/zerocopy/tests/ui-msrv/ptr-is-invariant-over-v.rs
--- rpm-ostree-2025.6/vendor/zerocopy/tests/ui-msrv/ptr-is-invariant-over-v.rs	1969-12-31 19:00:00.000000000 -0500
+++ rpm-ostree-2025.7/vendor/zerocopy/tests/ui-msrv/ptr-is-invariant-over-v.rs	2025-03-28 12:01:17.000000000 -0400
@@ -0,0 +1,20 @@
+use zerocopy::pointer::{
+    invariant::{Aligned, Exclusive, Shared, Valid},
+    Ptr,
+};
+
+fn _when_exclusive<'big: 'small, 'small>(
+    big: Ptr<'small, &'big u32, (Exclusive, Aligned, Valid)>,
+    mut _small: Ptr<'small, &'small u32, (Exclusive, Aligned, Valid)>,
+) {
+    _small = big;
+}
+
+fn _when_shared<'big: 'small, 'small>(
+    big: Ptr<'small, &'big u32, (Shared, Aligned, Valid)>,
+    mut _small: Ptr<'small, &'small u32, (Shared, Aligned, Valid)>,
+) {
+    _small = big;
+}
+
+fn main() {}
