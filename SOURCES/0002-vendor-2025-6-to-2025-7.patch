+env -u RUSTFLAGS cargo +stable build --manifest-path tools/Cargo.toml -p cargo-zerocopy -q
+# Thin wrapper around the `cargo-zerocopy` binary in `tools/cargo-zerocopy`
+./tools/target/debug/cargo-zerocopy $@
