-    rustdoc::invalid_codeblock_attributes,
-    rustdoc::invalid_html_tags,
-    rustdoc::invalid_rust_codeblocks,
-    rustdoc::missing_crate_level_docs,
-    rustdoc::private_intra_doc_links
