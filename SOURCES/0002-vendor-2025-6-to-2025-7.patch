+        // types must implement `TryFromBytesTestable` directly (ie using
+        // `impl_try_from_bytes_testable!`).
+        trait TryFromBytesTestable {
+            fn with_passing_test_cases<F: Fn(Box<Self>)>(f: F);
+            fn with_failing_test_cases<F: Fn(&mut [u8])>(f: F);
